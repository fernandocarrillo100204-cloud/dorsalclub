rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Colecciones retiradas: se conserva únicamente lectura histórica.
    match /almacenes/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /stock/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Productos Collection
    match /productos/{sku} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(sku)
        && incoming().nombre is string && incoming().nombre.size() > 0 && incoming().nombre.size() <= 120
        && incoming().stock_minimo is number && incoming().stock_minimo >= 0;
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    // Movimientos Collection
    match /movimientos/{movimientoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(movimientoId)
        && incoming().sku is string
        && incoming().tipo in ['entrada', 'salida', 'ajuste']
        && incoming().cantidad is number && incoming().cantidad > 0;
      allow update: if isSignedIn() && existing().tipo != 'transferencia' && incoming().tipo == existing().tipo && (
        (
          (!('estado' in existing()) || existing().estado != 'anulado')
          && incoming().estado == 'anulado'
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'estado', 'anulado_at', 'anulado_por', 'motivo_anulacion',
            'en_papelera', 'desactivado_at', 'estado_antes_papelera', 'periodo_descontado_papelera'
          ])
          && incoming().anulado_at is timestamp
          && incoming().anulado_por is string && incoming().anulado_por.size() > 0 && incoming().anulado_por.size() <= 200
          && incoming().motivo_anulacion is string && incoming().motivo_anulacion.size() > 0 && incoming().motivo_anulacion.size() <= 500
        )
        ||
        (
          (!('estado' in existing()) || existing().estado == 'activo')
          && incoming().estado == 'activo'
          && incoming().diff(existing()).affectedKeys().hasOnly(['en_papelera', 'desactivado_at', 'estado_antes_papelera', 'periodo_descontado_papelera'])
        )
        ||
        (
          existing().estado == 'anulado'
          && incoming().estado == 'anulado'
          && incoming().diff(existing()).affectedKeys().hasOnly(['en_papelera', 'desactivado_at', 'estado_antes_papelera', 'periodo_descontado_papelera'])
        )
        ||
        (
          existing().estado == 'anulado'
          && incoming().estado == 'activo'
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'estado', 'anulado_at', 'anulado_por', 'motivo_anulacion',
            'en_papelera', 'desactivado_at', 'estado_antes_papelera', 'periodo_descontado_papelera'
          ])
        )
        ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['drop_id', 'drop_nombre'])
          && incoming().diff(existing()).affectedKeys().hasAny(['drop_id', 'drop_nombre'])
          && (!('drop_id' in incoming()) || (incoming().drop_id is string && incoming().drop_id.size() > 0 && incoming().drop_id.size() <= 128))
          && (!('drop_nombre' in incoming()) || (incoming().drop_nombre is string && incoming().drop_nombre.size() <= 100))
        )
        ||
        (
          // Ajuste específico de un flete, nunca de precios/cantidades/inventario.
          existing().tipo == 'salida'
          && (!('subtipo' in existing()) || existing().subtipo == null)
          && (!('en_papelera' in existing()) || existing().en_papelera != true)
          && (!('estado' in existing()) || existing().estado == 'activo')
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'costo_envio_venta', 'total_costos_venta', 'venta_total_costos',
            'estado_pago_flete', 'flete_pagado_at'
          ])
          && incoming().diff(existing()).affectedKeys().hasAny([
            'costo_envio_venta', 'total_costos_venta', 'venta_total_costos',
            'estado_pago_flete', 'flete_pagado_at'
          ])
          && (!('costo_envio_venta' in incoming()) ||
              (incoming().costo_envio_venta is number && incoming().costo_envio_venta >= 0))
          && (!('total_costos_venta' in incoming()) ||
              (incoming().total_costos_venta is number && incoming().total_costos_venta >= 0))
          && (!('venta_total_costos' in incoming()) ||
              (incoming().venta_total_costos is number && incoming().venta_total_costos >= 0))
          && (!('estado_pago_flete' in incoming()) ||
              incoming().estado_pago_flete in ['pagado', 'pendiente'])
          && (!('flete_pagado_at' in incoming()) ||
              (incoming().flete_pagado_at is timestamp && incoming().estado_pago_flete == 'pagado'))
          && (!('estado_pago_flete' in incoming()) || incoming().estado_pago_flete != 'pagado' ||
              ('flete_pagado_at' in incoming() && incoming().flete_pagado_at is timestamp))
        )
      );
      allow delete: if isSignedIn() && existing().tipo != 'transferencia' && existing().en_papelera == true;
    }

    // Documento maestro de cada venta. Las partidas de inventario siguen en movimientos.
    match /ventas/{ventaId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(ventaId)
        && incoming().folio is string && incoming().folio.size() > 0
        && incoming().items is list
        && incoming().total is number && incoming().total >= 0
        && incoming().recibido is number && incoming().recibido >= 0
        && incoming().saldo is number && incoming().saldo >= 0;
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    // Compras Collection
    match /compras/{compraId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(compraId);
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    // Clientes Collection
    match /clientes/{clienteId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(clienteId)
        && incoming().nombre_completo is string && incoming().nombre_completo.size() > 0
        && incoming().tipo_cliente is string
        && incoming().tipo_cliente.size() > 0 && incoming().tipo_cliente.size() <= 80;
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    // Gastos Collection
    match /gastos/{gastoId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(gastoId)
        && incoming().concepto is string && incoming().concepto.size() > 0 && incoming().concepto.size() <= 200
        && incoming().categoria is string
        && incoming().categoria.size() > 0 && incoming().categoria.size() <= 100
        && incoming().monto is number && incoming().monto > 0
        && incoming().fecha is timestamp
        && incoming().fecha_str is string && incoming().fecha_str.size() > 0
        && (!('metodo_pago' in incoming()) || (
          incoming().metodo_pago is string 
          && incoming().metodo_pago.size() > 0 && incoming().metodo_pago.size() <= 100
        ));
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    // Movimientos financieros manuales: capital, otros ingresos, retiros y ajustes.
    // Las ventas, compras y gastos conservan sus colecciones de origen.
    match /movimientos_financieros/{movimientoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(movimientoId)
        && incoming().tipo in ['aportacion_capital', 'otro_ingreso', 'retiro_propietario', 'ajuste_entrada', 'ajuste_salida']
        && incoming().concepto is string && incoming().concepto.size() > 0 && incoming().concepto.size() <= 200
        && incoming().monto is number && incoming().monto > 0
        && incoming().fecha is timestamp
        && incoming().fecha_str is string && incoming().fecha_str.size() > 0
        && incoming().estado == 'activo';
      allow update: if isSignedIn()
        && existing().estado == 'activo'
        && incoming().estado == 'anulado'
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'estado', 'motivo_anulacion', 'anulado_at', 'anulado_por', 'actualizado_at'
        ])
        && incoming().motivo_anulacion is string
        && incoming().motivo_anulacion.size() > 0 && incoming().motivo_anulacion.size() <= 500;
      allow delete: if false;
    }

    // Drops comerciales: agrupadores independientes del calendario para compras y ventas.
    match /drops/{dropId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(dropId)
        && incoming().nombre is string
        && incoming().nombre.size() > 0 && incoming().nombre.size() <= 100
        && incoming().estado in ['preparacion', 'en_venta', 'cerrado']
        && (!('descripcion' in incoming()) || (
          incoming().descripcion is string && incoming().descripcion.size() <= 500
        ));
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    // Migraciones Collection (one-time migration trackers)
    match /migraciones/{migracionId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }

    // Contadores Collection (used for atomic folio generation)
    match /contadores/{contadorId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(contadorId);
      allow delete: if false;
    }

    // Resúmenes anteriores al inventario por drops: sin nuevas escrituras.
    match /resumen_ventas/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Catalogs & System Configuration
    match /catalogo_categorias/{catId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    match /catalogo_marcas/{marcaId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    match /catalogo_colores/{colorId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    match /catalogo_tallas_ropa/{tallaId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    match /catalogo_tallas_calzado/{tallaId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    match /catalogo_unidades/{unitId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    match /catalogo_ubicaciones_entrega/{ubicacionId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    match /catalogo_repartidores/{repartidorId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && existing().en_papelera == true;
    }

    match /configuracion/{configId} {
      allow read, write: if isSignedIn();
    }

    // Periodos Financieros Collection (Índice liviano para selector de periodos reales)
    match /periodos_financieros/{periodoKey} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(periodoKey)
        && incoming().periodo is string && incoming().periodo.size() == 7
        && incoming().anio is number && incoming().anio >= 2000 && incoming().anio <= 2100
        && incoming().mes is number && incoming().mes >= 1 && incoming().mes <= 12
        && incoming().ventasActivas is number && incoming().ventasActivas >= 0
        && incoming().comprasActivas is number && incoming().comprasActivas >= 0
        && incoming().gastosActivos is number && incoming().gastosActivos >= 0
        && incoming().totalRegistrosActivos is number && incoming().totalRegistrosActivos >= 0;
      allow delete: if isSignedIn();
    }
  }
}
